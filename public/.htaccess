# SPA fallback for Apache or LiteSpeed hosts. Nginx hosts use deploy/nginx-aotd.conf instead.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

<Files "sw.js">
  Header set Cache-Control "no-cache"
</Files>
