# Copy to scripts/.env (ignored by Git) and fill in. Same format as the Akaread scripts.

WEB_HOST=178.16.142.64
WEB_USER=root
WEB_PASSWORD=""
# Optional instead of the password: path to a private SSH key
WEB_KEY_PATH=
# Optional: pins the server SSH host key. Get it on the server with
#   ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub
# Without it, run "./scripts/deploy.sh --trust-host" once to record the key in scripts/.known_hosts.
WEB_HOST_FINGERPRINT=
WEB_PATH="/home/eduardoalves-aotd/htdocs/aotd.eduardoalves.tech"
WEB_IGNORED_FOLDER="node_modules,.history,.git,.vscode,design,coverage,playwright-report,test-results"

# Node.js version for the build and the push server. deploy.sh installs it with
# nvm the first time if needed (the system node, 18 on Ubuntu, is too old for Vite 8).
# 22.22 is the oldest version every dev dependency accepts.
NODE_VERSION=22.22

# Runs on the server after the build, from WEB_PATH.
# Installs server/, creates server/.env with VAPID keys on the first run and recreates the push server in pm2 (aotd).
COMMAND="cd server && npm ci --omit=dev --no-audit --no-fund && npm run setup-env && (pm2 delete aotd >/dev/null 2>&1 || true) && pm2 start ecosystem.config.cjs && pm2 save"

# Days that hashed assets of older deploys stay available for tabs still open.
ASSET_RETENTION_DAYS=30

# URL deploy.sh checks after the deploy
SITE_URL="https://aotd.eduardoalves.tech"
