# Port of the Node.js app in CloudPanel (the vhost proxies /api/push/ to it).
# For local development use "npm run dev:push" instead, which picks the right port.
PORT=7115
HOST=127.0.0.1
DATA_DIR=./data
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@eduardoalves.tech
# Comma separated list of the sites allowed to change subscriptions.
ALLOWED_ORIGIN=https://aotd.eduardoalves.tech
REFRESH_MINUTES=15
